{
  "name": "reachinbox-scheduler-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Email job scheduler API and worker: BullMQ delayed jobs, Redis-backed rate limiting, Elasticsearch search",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:status": "prisma migrate status",
    "prisma:studio": "prisma studio",
    "check:deps": "tsx src/scripts/checkDependencies.ts"
  },
  "dependencies": {
    "@bull-board/api": "9.9.0",
    "@bull-board/express": "9.9.0",
    "@elastic/elasticsearch": "9.5.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10.0",
    "bullmq": "6.3.4",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "google-auth-library": "11.0.2",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "multer": "2.3.0",
    "nodemailer": "10.0.1",
    "papaparse": "5.7.0",
    "pg": "^8.16.3",
    "pino": "10.3.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/multer": "2.2.0",
    "@types/node": "26.5.0",
    "@types/papaparse": "5.5.2",
    "@types/pg": "^8.16.0",
    "@types/supertest": "7.2.1",
    "dotenv": "^17.2.3",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.2.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  },
  "allowScripts": {
    "prisma@7.10.0": true,
    "@prisma/engines@7.10.0": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract@3.0.4": true
  }
}
