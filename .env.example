# ─────────────────────────────────────────────────────────────────────────────
# ReachInbox Email Job Scheduler — environment template
#
# Copy to backend/.env and fill in. Every value is validated at boot by
# backend/src/config/env.ts, which refuses to start on a missing or malformed
# entry and prints every problem at once.
#
# Two ways to run the datastores:
#   A) Docker:  `docker compose up -d postgres redis` then use the local URLs
#               commented below.
#   B) Managed: Neon + Redis Cloud + Elastic Cloud (what this project was
#               developed against). Paste those URLs instead.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of browser origins allowed to send credentialed requests.
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:4000
# Hosted image only. Leave unset locally — Vite proxies /api instead.
# FRONTEND_DIST=/app/public

# ── PostgreSQL ───────────────────────────────────────────────────────────────
# DATABASE_URL is the POOLED connection, used at runtime by the Prisma driver
# adapter. DIRECT_URL is the UNPOOLED connection, used by the Prisma CLI for
# migrations — migrations cannot run through PgBouncer (prepared statements are
# incompatible with transaction pooling). With plain Docker Postgres, set both
# to the same value.
#
# Docker:  postgresql://postgres:postgres@localhost:5432/reachinbox
# Neon:    postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/reachinbox?sslmode=require
DATABASE_URL=
DIRECT_URL=

# ── Redis ────────────────────────────────────────────────────────────────────
# Holds the BullMQ delayed sets and the rate-limit counters.
#
# Docker:      redis://localhost:6379
# Redis Cloud: redis://default:PASSWORD@HOST:PORT
REDIS_URL=
REDIS_PREFIX=reachinbox
# Redis MUST NOT evict keys: an evicted BullMQ delayed-set entry silently
# destroys a scheduled email. Boot asserts `maxmemory-policy=noeviction`.
# Only set false if your provider blocks CONFIG GET and you have verified the
# policy by hand.
REDIS_ASSERT_NOEVICTION=true

# ── Security ─────────────────────────────────────────────────────────────────
# Generate both:  openssl rand -hex 32
# On Windows:     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_JWT_SECRET=
# Exactly 64 hex characters (32 bytes). Encrypts SMTP passwords and Slack
# webhook URLs at rest. Changing it makes existing ciphertext unreadable.
ENCRYPTION_KEY=
SESSION_TTL_DAYS=7

# Development identity until Google OAuth (Phase 4). Production ignores this.
# `npm run seed:senders` prints the id to paste here.
DEV_USER_ID=

# ── Elasticsearch (optional; search degrades to Postgres without it) ─────────
SEARCH_ENABLED=true
# Docker:        http://localhost:9200
# Elastic Cloud: https://xxx.es.REGION.aws.elastic.cloud:443
ELASTICSEARCH_URL=
# Elastic Cloud: use an API key. Local container with security off: leave blank.
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_INDEX=emails

# ── Google OAuth ─────────────────────────────────────────────────────────────
# console.cloud.google.com > APIs & Services > Credentials > OAuth client ID
# (Web application). Authorised redirect URI must be exactly:
#   http://localhost:4000/api/auth/google/callback
# Consent screen: Testing + add test users. Restart the API after pasting IDs.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# ── Slack OAuth ──────────────────────────────────────────────────────────────
# api.slack.com/apps > Create New App > OAuth & Permissions.
# Redirect URL must be exactly:
#   http://localhost:4000/api/slack/callback
# Scope: incoming-webhook (not chat:write). Restart the API after pasting IDs.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback
SLACK_SCOPES=incoming-webhook

# ── Ethereal SMTP ────────────────────────────────────────────────────────────
ETHEREAL_HOST=smtp.ethereal.email
ETHEREAL_PORT=587
# Optional: pre-created accounts as JSON, to skip the network call at seed time.
# [{"user":"...","pass":"...","email":"..."}]
ETHEREAL_ACCOUNTS=[]
# How many Ethereal senders `npm run seed:senders` creates. Multiple senders is
# what makes the per-sender rate limit meaningful.
SEED_SENDER_COUNT=3

# ── Scheduler, throughput and rate limits ────────────────────────────────────
# All limits are configurable; nothing is hardcoded.
WORKER_CONCURRENCY=5
# Documented floor between individual sends, mimicking provider throttling.
# A campaign may request a longer delay but never a shorter one.
MIN_DELAY_BETWEEN_EMAILS_MS=2000
# Global ceiling across all senders.
MAX_EMAILS_PER_HOUR=1000
# Per-sender default; a sender row may override it.
MAX_EMAILS_PER_HOUR_PER_SENDER=200
# Above this pacing wait, a job re-delays itself instead of sleeping in a
# worker concurrency slot.
MAX_INLINE_WAIT_MS=5000
RATE_LIMIT_WINDOW_MS=3600000
EMAIL_JOB_ATTEMPTS=3
EMAIL_JOB_BACKOFF_MS=5000
# Recipients per fan-out batch when expanding a campaign.
EXPAND_BATCH_SIZE=500
# A row stuck in `claimed` longer than this was orphaned by a hard kill.
STALE_CLAIM_TIMEOUT_MS=300000
# One-shot DB->Redis repair on worker boot. Not a cron: it runs once, at start.
RECONCILE_ON_BOOT=true
MAX_CSV_BYTES=5242880
MAX_RECIPIENTS_PER_CAMPAIGN=50000

# ── Admin ────────────────────────────────────────────────────────────────────
# Comma-separated emails allowed to reach /admin/queues and the admin endpoints.
ADMIN_EMAILS=
# HTTP Basic fallback for the BullMQ dashboard, for demoing without a browser
# session. Leave blank to require a logged-in admin session instead.
BULL_BOARD_USER=
BULL_BOARD_PASSWORD=
