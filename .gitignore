# ── Dependencies
node_modules/
.pnp/
.pnp.js

# ── Secrets (never commit; .env.example is the tracked template)
.env
.env.*
!.env.example

# ── Build output
dist/
build/
*.tsbuildinfo

# ── Prisma
# Migrations ARE committed. The generated client is TypeScript source emitted by
# `prisma generate` (run in the build step), so it stays out of version control.
backend/src/generated/
backend/prisma/*.db
backend/prisma/*.db-journal

# Prisma 7 `init` drops agent-skill scaffolding we don't use
skills-lock.json
.claude/
.windsurf/
.agents/

# ── Test / coverage
coverage/
.nyc_output/
*.lcov

# ── Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Vite
frontend/dist/
frontend/.vite/
.vite/

# ── Local scratch
tmp/
temp/
*.local
uploads/
