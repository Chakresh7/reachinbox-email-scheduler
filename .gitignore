# ── Dependencies
node_modules/
.pnp/
.pnp.js

# ── Secrets (never commit; .env.example is the tracked template)
.env
.env.*
!.env.example

# ── Build output
dist/
build/
*.tsbuildinfo

# ── Prisma
# Migrations ARE committed. Generated client and local artifacts are not.
backend/prisma/generated/
backend/prisma/*.db
backend/prisma/*.db-journal

# ── Test / coverage
coverage/
.nyc_output/
*.lcov

# ── Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ── Vite
frontend/dist/
frontend/.vite/
.vite/

# ── Local scratch
tmp/
temp/
*.local
uploads/
